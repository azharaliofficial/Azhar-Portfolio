# Leave empty in development: Vite proxies /api and /storage to Laravel on :8000.
#
# For the live Netlify site keep this EMPTY too. The site then uses the saved copy of
# your data (made with `npm run sync`), so it does not need a live backend.
#
# Only set this if the Laravel API is public and allows requests from your site:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=
